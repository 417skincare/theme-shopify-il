{% comment %} {% comment %}
  International Market Popup — Shopify Section
  Add via: Online Store → Themes → Edit code → Sections → Add section
  Then add it to any template via the theme editor (can be shown/hidden per template)
{% endcomment %}

<div id="intl-popup-overlay" class="intl-popup-overlay" role="dialog" aria-modal="true" aria-labelledby="intl-popup-title">
  <div class="intl-popup-card">

    <button id="intl-popup-dismiss" class="intl-popup-close" aria-label="Close">&#10005;</button>

     <div class="intl-popup-logo"><img src="https://cdn.shopify.com/s/files/1/0766/4877/5780/files/logo_black.png?v=1781606947" alt="417 Logo" width="120px" height="120px"></div>

    <h2 id="intl-popup-title" class="intl-popup-title">
      {{ section.settings.heading }}
    </h2>

    <p class="intl-popup-subtitle">
      {{ section.settings.subtext }}
    </p>

    {%- render 'button',
      href: section.settings.button_url,
      content: section.settings.button_label -%}

  </div>
</div>

<style>
  .intl-popup-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    animation: intlFadeIn 0.3s ease;
    direction:ltr;
  }

  .intl-popup-card {
    position: relative;
    background: #fdfcfc;
    color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--popup-corner-radius, var(--buttons-radius, 8px));
    padding: 2.5rem 1.5rem;
    max-width: 420px;
    width: 100%;
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    animation: intlSlideUp 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .intl-popup-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: transparent;
    border: none;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.25rem 0.4rem;
    border-radius: 4px;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .intl-popup-close:hover {
    color: rgb(var(--color-foreground));
    background: rgba(var(--color-foreground), 0.06);
  }
    .intl-popup-logo{
    margin:0 auto;
    display:block;
    }

    .intl-popup-logo img{
    display: block;
    margin: 0 auto;
    }

  .intl-popup-title {
    font-family: inherit;
    font-weight: var(--font-heading-weight, 600);
    font-size: 1.2rem;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    color: rgb(var(--color-foreground));
  }

  .intl-popup-subtitle {
    font-family: inherit;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(var(--color-foreground), 0.7);
    margin: 0 0 1.75rem;
  }

  @keyframes intlFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes intlSlideUp {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .intl-popup-overlay.is-hidden {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .intl-popup-overlay,
    .intl-popup-card {
      animation: none;
    }
  }
</style>

<script>
  (function () {
    var overlay = document.getElementById('intl-popup-overlay');
    var dismiss = document.getElementById('intl-popup-dismiss');

    function closePopup() {
      overlay.classList.add('is-hidden');
      overlay.setAttribute('aria-hidden', 'true');
    }

    dismiss.addEventListener('click', closePopup);

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) closePopup();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closePopup();
    });
  })();
</script>

{% schema %}
{
  "name": "International Popup",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Looking for our international site?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Shop 417 Skincare products with international shipping, pricing, and support at our dedicated global store."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "International site URL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Visit International Site"
    }
  ],
  "presets": [
    {
      "name": "International Popup"
    }
  ]
}
{% endschema %} {% endcomment %}
