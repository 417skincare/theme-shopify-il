<section
  class="vimeo-hero"
  id="vimeo-hero-{{ section.id }}"
  {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %}
>

  {% comment %} {{- "---------------- VIMEO VIDEO ----------------" | comment -}} {% endcomment %}
  <div class="vimeo-hero__video-wrapper" style="
    background-image: url('https://cdn.shopify.com/s/files/1/0766/4877/5780/files/Brand-Video-Cover.webp?v=1781416496');
    background-size: cover;
    background-position: center;
  ">
    <iframe
      class="vimeo-hero__iframe"
      src="https://player.vimeo.com/video/{{ section.settings.vimeo_id }}?background=1&autoplay=1&loop=1&muted=1&controls=0&playsinline=1&autopause=0"
      frameborder="0"
      allow="autoplay; fullscreen"
      allowfullscreen
      title="{{ section.settings.video_title | escape }}"
    ></iframe>
  </div>

  {%- if section.settings.gradient_overlay != blank -%}
    <div class="vimeo-hero__gradient" style="background: {{ section.settings.gradient_overlay }};"></div>
  {%- endif -%}

  {% comment %} {{- "---------------- CONTENT ----------------" | comment -}} {% endcomment %}
  <div class="vimeo-hero__content {{ section.settings.mobile_text_position }} {{ section.settings.desktop_text_position }}" style="--content-max-width: {{ section.settings.content_max_width }}px;">
    <div class="prose" style="{% render 'surface', text_color: section.settings.text_color %}">
      {%- if section.settings.subheading != blank -%}
        <p class="h6">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <p class="h1">{{ section.settings.title }}</p>
      {%- endif -%}

      {%- if section.settings.button_1_text != blank or section.settings.button_2_text != blank -%}
        {%- assign button_mobile_position = section.settings.mobile_text_position | split: 'text-' | last -%}
        {%- assign button_desktop_position = section.settings.desktop_text_position | split: 'text-' | last -%}

        {%- if section.settings.button_1_style == 'link' or section.settings.button_2_style == 'link' or section.settings.button_1_text == blank or section.settings.button_2_text == blank -%}
          {%- capture button_wrapper_class -%}button-group justify-{{ button_mobile_position }} sm:justify-{{ button_desktop_position }}{%- endcapture -%}
        {%- else -%}
          {%- capture button_wrapper_class -%}button-group button-group--same-width justify-{{ button_mobile_position }} sm:justify-{{ button_desktop_position }}{%- endcapture -%}
        {%- endif -%}

        <div class="{{ button_wrapper_class }}">
          {%- if section.settings.button_1_text != blank -%}
            {%- render 'button', href: section.settings.button_1_link, content: section.settings.button_1_text, style: section.settings.button_1_style, background: section.settings.button_1_background, text_color: section.settings.button_1_text_color -%}
          {%- endif -%}
          {%- if section.settings.button_2_text != blank -%}
            {%- render 'button', href: section.settings.button_2_link, content: section.settings.button_2_text, style: section.settings.button_2_style, background: section.settings.button_2_background, text_color: section.settings.button_2_text_color -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  /* Strip any spacing Shopify adds to the section wrapper */
  .shopify-section:has(#vimeo-hero-{{ section.id }}) {
    margin: 0 !important;
    padding: 0 !important;
  }

  /* ── Section shell ── */
  #vimeo-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.hero_height }}vh;
    min-height: 400px;
    overflow: hidden;
    margin: 0;
    padding: 0;
    line-height: 0;
    font-size: 0;
  }

  /* ── Cover-fit video wrapper ── */
  #vimeo-hero-{{ section.id }} .vimeo-hero__video-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    min-width: calc(100vh * (16 / 9));
    min-height: calc(100vw * (9 / 16));
  }

  #vimeo-hero-{{ section.id }} .vimeo-hero__iframe {
    display: block;
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: 0;
    pointer-events: none;
  }

  /* ── Gradient overlay ── */
  #vimeo-hero-{{ section.id }} .vimeo-hero__gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* ── Content layer ── */
  /* Stretch to fill the full section so place-self-* positions relative to it */
  #vimeo-hero-{{ section.id }} .vimeo-hero__content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    padding: 1.5rem;
    line-height: normal;
    font-size: initial;
  }

  /* .prose is the grid item — place-self-* from Prestige's utilities move it */
  #vimeo-hero-{{ section.id }} .vimeo-hero__content .prose {
    max-width: var(--content-max-width, 780px);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    #vimeo-hero-{{ section.id }} .vimeo-hero__video-wrapper {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Vimeo Hero Banner",
  "class": "shopify-section--slideshow",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "text",
      "id": "vimeo_id",
      "label": "Vimeo Video ID",
      "info": "Found in your Vimeo URL: vimeo.com/[VIDEO_ID]",
      "placeholder": "123456789"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Video title (accessibility)",
      "default": "Hero background video"
    },
    {
      "type": "checkbox",
      "id": "allow_transparent_header",
      "label": "Allow transparent header",
      "info": "Enable if your header supports transparency over the hero",
      "default": true
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "mobile_text_position",
      "label": "Mobile content position",
      "options": [
        { "value": "place-self-start text-start",         "label": "Top left" },
        { "value": "place-self-start-center text-center", "label": "Top center" },
        { "value": "place-self-start-end text-end",       "label": "Top right" },
        { "value": "place-self-center-start text-start",  "label": "Middle left" },
        { "value": "place-self-center text-center",       "label": "Middle center" },
        { "value": "place-self-center-end text-end",      "label": "Middle right" },
        { "value": "place-self-end-start text-start",     "label": "Bottom left" },
        { "value": "place-self-end-center text-center",   "label": "Bottom center" },
        { "value": "place-self-end text-end",             "label": "Bottom right" }
      ],
      "default": "place-self-center text-center"
    },
    {
      "type": "select",
      "id": "desktop_text_position",
      "label": "Desktop content position",
      "options": [
        { "value": "sm:place-self-start sm:text-start",         "label": "Top left" },
        { "value": "sm:place-self-start-center sm:text-center", "label": "Top center" },
        { "value": "sm:place-self-start-end sm:text-end",       "label": "Top right" },
        { "value": "sm:place-self-center-start sm:text-start",  "label": "Middle left" },
        { "value": "sm:place-self-center sm:text-center",       "label": "Middle center" },
        { "value": "sm:place-self-center-end sm:text-end",      "label": "Middle right" },
        { "value": "sm:place-self-end-start sm:text-start",     "label": "Bottom left" },
        { "value": "sm:place-self-end-center sm:text-center",   "label": "Bottom center" },
        { "value": "sm:place-self-end sm:text-end",             "label": "Bottom right" }
      ],
      "default": "sm:place-self-center sm:text-center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content maximum width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 780
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "Style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "solid",   "label": "Solid" },
        { "value": "link",    "label": "Link" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "button_1_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_1_text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "solid",   "label": "Solid" },
        { "value": "link",    "label": "Link" }
      ],
      "default": "outline"
    },
    {
      "type": "color",
      "id": "button_2_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_2_text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "gradient_overlay",
      "label": "Gradient overlay",
      "default": "linear-gradient(180deg, rgba(54, 54, 54, 0.2) 0%, rgba(4, 4, 4, 0.65) 100%)",
      "info": "Adds a color/gradient over the video to improve text legibility"
    }
  ],
  "presets": [
    {
      "name": "Vimeo Hero Banner",
      "category": "Banners"
    }
  ]
}
{% endschema %}
